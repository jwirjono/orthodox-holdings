# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: The public origin the site is served from, with no trailing slash.
# Drives the canonical URL, hreflang alternates, Open Graph URLs, the JSON-LD
# graph and sitemap.xml. Leave it unset and the build omits all of those rather
# than pointing them at the wrong origin — set it in Vercel too, not just here.
VITE_SITE_URL="https://orthodoxholding.com"

# Contact forms. Used by api/contact.ts and the Vite dev middleware in vite.config.ts.
# One Gmail account sends every enquiry. SMTP_PASS is that account's App Password
# (Google Account → Security → 2-Step Verification → App passwords), not its sign-in password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sender@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"
# Optional; defaults to SMTP_USER. Gmail sends as SMTP_USER unless this is a verified "Send mail as" alias.
SMTP_FROM=""

# Inbox for each form.
BUSINESS_SMTP_TO="businesssolutions@orthodoxholding.com"
WEALTH_SMTP_TO="wealthmanagement@orthodoxholding.com"
